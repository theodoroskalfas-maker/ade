# Passcode required to POST /api/parties (add a party).
# Leave empty in local dev to allow adds without a code.
ADD_PASSCODE=

# Vercel KV — only needed in production (fill in from Vercel Storage UI).
# In local dev the app falls back to a JSON file at .data/user-parties.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
